# Bengkel Mobil GPS Motor Kediri - Environment Configuration Template

# Server Configuration
PORT=3000
NODE_ENV=production

# Session & Security
SESSION_SECRET=bengkel_gps_motor_super_secure_random_session_secret_2026

# Storage Paths (Optional - defaults to project relative directories)
DB_PATH=./data/bengkel.db
UPLOAD_DIR=./uploads
IMAGE_STORAGE_SALT=bengkel-gps-motor-secure-salt-2026

# Single-User Google OAuth 2.0 (Optional - Local mock login works 100% offline)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Superadmin Configuration
SUPERADMIN_EMAIL=superadmin@example.com
VITE_SUPERADMIN_EMAILS=superadmin@example.com,developer@example.com

# Supabase Configuration (Cloud Database & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_anon_key
VITE_SUPABASE_BUCKET=bucket3

# Default Multi-Tenant Workshop Branding (Optional)
VITE_DEFAULT_TENANT_ID=tenant-gps-motor-kediri-01
VITE_DEFAULT_WORKSHOP_NAME=Bengkel Mobil Mitra
VITE_DEFAULT_WORKSHOP_TAGLINE=Layanan Servis Mobil Modern, Transparan & Bergaransi
VITE_DEFAULT_WORKSHOP_PHONE=081234567890
VITE_DEFAULT_WORKSHOP_ADDRESS=Jl. Raya Utama No. 88, Indonesia


